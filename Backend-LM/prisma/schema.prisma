generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Employee {
    employeeId String @id @default(uuid())
    name       String
    jobTitle   String
    department String
    location   String
    phone      String @unique
    // leaveRequests LeaveRequest[]
    // leaveHistory  LeaveHistory[]
}

model LeaveRequest {
    id             String        @id @default(uuid())
    employeeId     String
    lineManagerId  String?
    leaveType      LeaveType
    startDate      DateTime
    endDate        DateTime
    reason         String
    supportingDocs String? // URL of uploaded document
    leaveDuration  LeaveDuration
    status         LeaveStatus   @default(PENDING) // Default as Pending for admin approval
    appliedOn      DateTime      @default(now())
    decisionAt     DateTime? // New field: when a decision was made (approved or rejected)
    adminRemarks   String? // Admin remarks in case of rejection
    // employee       Employee      @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
    // leaveRequestTemp LeaveRequestTemp
    startDateTemp  DateTime?
    endDateTemp    DateTime?
    reasonTemp     String?
    editStatus     EditStatus?  @default(NULL)
}




model LeaveHistory {
    id             String      @id @default(uuid())
    employeeId     String
    leaveType      LeaveType
    duration       Float
    appliedOn      DateTime
    startDate      DateTime?
    endDate        DateTime?
    status         LeaveStatus
    adminRemarks   String?
    supportingDocs String?
    paidLeave      Int         @default(0)
    unpaidLeave    Int         @default(0)
    // employee       Employee    @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
}

model LeaveBalance {
    id         String    @id @default(uuid())
    employeeId String
    leaveType  LeaveType
    balance    Float

    @@unique([employeeId, leaveType])
}

model LeavePolicy {
    id             String   @id @default(uuid())
    policyName     String
    policyCategory String
    documentUrl    String // URL of uploaded policy document
    createdAt      DateTime @default(now())
}

model Holiday {
    id        String   @id @default(uuid())
    date      DateTime @unique
    title     String
    createdAt DateTime @default(now())
    location  String
}

enum LeaveType {
    CASUAL
    SICK
    COMPENSATORY
    UNPAID
}

enum LeaveDuration {
    FULL_DAY
    HALF_DAY
}

enum LeaveStatus {
    All
    PENDING
    APPROVED
    REJECTED
    EDITED
    ON_HOLD
    CANCELLED
}

enum EditStatus {
    NULL
    CANCELLED
    EDITED
}
