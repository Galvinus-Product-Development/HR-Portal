// Prisma Schema Definition for Attendance Tracker
generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model Employee {
    id                     String                   @id @default(auto()) @map("_id") @db.ObjectId
    name                   String
    jobTitle               String
    department             Department               @default(null)
    location               String
    phone                  String                   @unique
    attendance             Attendance[]
    monthlyAttendanceStats MonthlyAttendanceStats[]
    overtime               Overtime[] //----CHANGED HERE --------//
}

model Attendance {
    id               String    @id @default(auto()) @map("_id") @db.ObjectId
    employeeId       String    @db.ObjectId
    date             DateTime  @default(now())
    punchInTime      DateTime?
    punchOutTime     DateTime?
    attendanceStatus Status    @default(Absent)
    punchInMethod    String?
    punchOutMethod   String?
    workingHours     Int?      @default(0)
    lateComing       Int?      @default(0)
	lateDays             Int?           @default(0)
	earlyLeaving         Int?           @default(0) // ------------------ CHANGED HERE ------------------------
    overtime         Int?      @default(0)
    employee         Employee  @relation(fields: [employeeId], references: [id]) 
	@@unique([employeeId, date]) // ------------------- CHANGED HERE ------------------------

}

model MonthlyAttendanceStats {
    id                String   @id @default(auto()) @map("_id") @db.ObjectId
    employeeId        String   @db.ObjectId
    monthYear         String // e.g., "2025-03"
    workingDays       Int      @default(22)
    presentDays       Int      @default(0)
    absentDays        Int      @default(0)
    halfDays          Int      @default(0)
    lateDays          Int      @default(0)
    monthlyLateComing Int      @default(0)
	earlyLeaving      Int      @default(0) // ---------------------- CHANGED HERE ---------------------------
    overtimeHours     Int      @default(0)
    employee          Employee @relation(fields: [employeeId], references: [id])

    @@unique([employeeId, monthYear])
}

//------CHANGED HERE --------//
model Overtime {
    id             String         @id @default(auto()) @map("_id") @db.ObjectId
    employeeId     String         @db.ObjectId
    appliedOn       DateTime
    date           DateTime
    startTime      DateTime
    endTime        DateTime
    duration       Int
    reason         String
    overtimeStatus OvertimeStatus @default(null)
    employee       Employee       @relation(fields: [employeeId], references: [id])
}

enum OvertimeStatus {
    null
    REQUESTED
    REQUESTACCEPTED
    REQUESTREJECTED
    CLAIMOVERTIMEREQUESTEED
    OVERTIMEACCEPTED
    OVERTIMEREJECTED
}

enum Department {
    null
    HR
    Engineering
    Finance
    Marketing
}

enum Status {
    null
    Present
    Absent
    Half_Day
    On_Leave
}
